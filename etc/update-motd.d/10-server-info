#!/bin/bash

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly FIELD_WIDTH=24

extract_route_device() {
    local route=$1
    local previous=""
    local token
    local -a route_tokens=()

    read -r -a route_tokens <<< "$route"

    for token in "${route_tokens[@]}"; do
        if [[ $previous == "dev" ]]; then
            printf '%s' "$token"
            return 0
        fi
        previous=$token
    done

    return 1
}

print_field() {
    local label=$1
    local value=$2
    local width=$FIELD_WIDTH

    if ((${#label} > width)); then
        width=${#label}
    fi

    printf '  %-*s %s\n' "$width" "$label" "$value"
}

print_multiline_field() {
    local label=$1
    local empty_value=$2
    local width=$FIELD_WIDTH
    local value
    shift 2

    if (($# == 0)); then
        print_field "$label" "$empty_value"
        return 0
    fi

    if ((${#label} > width)); then
        width=${#label}
    fi

    printf '  %-*s %s\n' "$width" "$label" "$1"
    shift

    for value in "$@"; do
        printf '  %-*s %s\n' "$width" "" "$value"
    done
}

collect_system_info() {
    local uname_output=""

    VERSION_ID="unknown"
    VERSION_CODENAME=""

    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release 2>/dev/null || true
    fi

    hostname="unknown"

    if [[ -r /proc/sys/kernel/hostname ]]; then
        IFS= read -r hostname < /proc/sys/kernel/hostname || hostname="unknown"
    fi

    hostname=${hostname:-unknown}
    kernel="unknown"
    architecture="unknown"

    if command -v uname >/dev/null 2>&1 &&
        uname_output=$(uname -rm 2>/dev/null); then
        read -r kernel architecture <<< "$uname_output"
    fi

    kernel=${kernel:-unknown}
    architecture=${architecture:-unknown}
    os_text="Debian ${VERSION_ID:-unknown}"

    if [[ -n ${VERSION_CODENAME:-} ]]; then
        os_text+=" (${VERSION_CODENAME})"
    fi

    timestamp="unknown"

    if command -v date >/dev/null 2>&1; then
        timestamp=$(date '+%d.%m.%Y %H:%M %Z' 2>/dev/null)
    fi

    timestamp=${timestamp:-unknown}
}

collect_uptime() {
    local index
    local uptime_days
    local uptime_hours
    local uptime_minutes
    local uptime_raw
    local uptime_seconds
    local -a uptime_parts=()

    uptime_text="unavailable"

    if [[ ! -r /proc/uptime ]] ||
        ! read -r uptime_raw _ < /proc/uptime; then
        return 0
    fi

    uptime_seconds=${uptime_raw%%.*}

    if [[ ! $uptime_seconds =~ ^[0-9]+$ ]]; then
        return 0
    fi

    uptime_days=$((uptime_seconds / 86400))
    uptime_hours=$(((uptime_seconds % 86400) / 3600))
    uptime_minutes=$(((uptime_seconds % 3600) / 60))

    if ((uptime_days > 0)); then
        if ((uptime_days == 1)); then
            uptime_parts+=("${uptime_days} day")
        else
            uptime_parts+=("${uptime_days} days")
        fi
    fi

    if ((uptime_hours > 0)); then
        if ((uptime_hours == 1)); then
            uptime_parts+=("${uptime_hours} hour")
        else
            uptime_parts+=("${uptime_hours} hours")
        fi
    fi

    if ((uptime_minutes > 0)); then
        if ((uptime_minutes == 1)); then
            uptime_parts+=("${uptime_minutes} minute")
        else
            uptime_parts+=("${uptime_minutes} minutes")
        fi
    fi

    if ((${#uptime_parts[@]} == 0)); then
        uptime_text="less than a minute"
        return 0
    fi

    uptime_text=${uptime_parts[0]}

    for ((index = 1; index < ${#uptime_parts[@]}; index++)); do
        uptime_text+=", ${uptime_parts[index]}"
    done
}

collect_cpu_info() {
    local core_word
    local cpu_model=""
    local key
    local logical_cpus=""
    local physical_cores=""
    local thread_word
    local topology=""
    local value
    local virtual_cpus=""

    cpu_text="unavailable"
    virtualization="unknown"

    if [[ -r /proc/cpuinfo ]]; then
        while IFS=: read -r key value; do
            key=${key//[[:space:]]/}

            if [[ $key == "modelname" ]]; then
                read -r cpu_model <<< "$value"
                break
            fi
        done < /proc/cpuinfo
    fi

    if [[ -z $cpu_model ]] &&
        command -v lscpu >/dev/null 2>&1 &&
        command -v awk >/dev/null 2>&1; then
        cpu_model=$(
            lscpu 2>/dev/null |
                awk -F: '
                    /^Model name:/ {
                        sub(/^[[:space:]]+/, "", $2)
                        print $2
                        exit
                    }
                '
        )
    fi

    cpu_model=${cpu_model:-unknown}

    if command -v systemd-detect-virt >/dev/null 2>&1; then
        if ! virtualization=$(systemd-detect-virt 2>/dev/null); then
            virtualization="none"
        elif [[ -z $virtualization ]]; then
            virtualization="unknown"
        fi
    fi

    case $virtualization in
        none)
            if command -v lscpu >/dev/null 2>&1 &&
                command -v awk >/dev/null 2>&1; then
                topology=$(
                    lscpu --parse=CPU,SOCKET,CORE --online 2>/dev/null |
                        awk -F, '
                            !/^#/ && NF >= 3 {
                                logical++
                                core_id = $2 ":" $3
                                cores[core_id] = 1
                            }

                            END {
                                for (core_id in cores) {
                                    core_count++
                                }

                                print logical + 0, core_count + 0
                            }
                        '
                )
                read -r logical_cpus physical_cores <<< "$topology"
            fi

            if [[ ! $logical_cpus =~ ^[0-9]+$ ]] ||
                ((logical_cpus == 0)); then
                logical_cpus=""

                if command -v nproc >/dev/null 2>&1; then
                    logical_cpus=$(nproc 2>/dev/null)
                fi
            fi

            if [[ ! $logical_cpus =~ ^[0-9]+$ ]] ||
                ((logical_cpus == 0)); then
                logical_cpus=""
            fi

            if [[ ! $physical_cores =~ ^[0-9]+$ ]] ||
                ((physical_cores == 0)); then
                physical_cores=""
            fi

            if [[ -n $logical_cpus && -n $physical_cores ]]; then
                core_word="cores"
                thread_word="threads"

                ((physical_cores == 1)) && core_word="core"
                ((logical_cpus == 1)) && thread_word="thread"

                cpu_text="${cpu_model} · ${physical_cores} ${core_word} / ${logical_cpus} ${thread_word}"
            elif [[ -n $logical_cpus ]]; then
                thread_word="threads"
                ((logical_cpus == 1)) && thread_word="thread"
                cpu_text="${cpu_model} · ${logical_cpus} ${thread_word}"
            elif [[ $cpu_model != "unknown" ]]; then
                cpu_text=$cpu_model
            fi
            ;;
        unknown)
            if command -v nproc >/dev/null 2>&1; then
                virtual_cpus=$(nproc 2>/dev/null)
            fi

            if [[ $virtual_cpus =~ ^[0-9]+$ ]] &&
                ((virtual_cpus > 0)); then
                if ((virtual_cpus == 1)); then
                    cpu_text="${cpu_model} · ${virtual_cpus} CPU"
                else
                    cpu_text="${cpu_model} · ${virtual_cpus} CPUs"
                fi
            elif [[ $cpu_model != "unknown" ]]; then
                cpu_text=$cpu_model
            fi
            ;;
        *)
            if command -v nproc >/dev/null 2>&1; then
                virtual_cpus=$(nproc 2>/dev/null)
            fi

            if [[ $virtual_cpus =~ ^[0-9]+$ ]] &&
                ((virtual_cpus > 0)); then
                if ((virtual_cpus == 1)); then
                    cpu_text="${cpu_model} · ${virtual_cpus} vCPU"
                else
                    cpu_text="${cpu_model} · ${virtual_cpus} vCPUs"
                fi
            elif [[ $cpu_model != "unknown" ]]; then
                cpu_text=$cpu_model
            fi
            ;;
    esac
}

collect_load_info() {
    local load_1
    local load_5
    local load_15
    local number_pattern='^[0-9]+([.][0-9]+)?$'

    load_text="unavailable"

    if [[ ! -r /proc/loadavg ]] ||
        ! read -r load_1 load_5 load_15 _ < /proc/loadavg; then
        return 0
    fi

    if [[ $load_1 =~ $number_pattern &&
        $load_5 =~ $number_pattern &&
        $load_15 =~ $number_pattern ]]; then
        load_text="${load_1} · ${load_5} · ${load_15} (1m · 5m · 15m)"
    fi
}

collect_memory_info() {
    local -a memory_lines=()

    memory_text="unavailable"
    swap_text="unavailable"

    if [[ ! -r /proc/meminfo ]] ||
        ! command -v awk >/dev/null 2>&1; then
        return 0
    fi

    mapfile -t memory_lines < <(
        awk '
            function tidy(number, text) {
                text = sprintf("%.2f", number)
                sub(/0+$/, "", text)
                sub(/\.$/, "", text)
                return text
            }

            /^MemTotal:/ {
                memory_total = $2
                have_memory_total = 1
            }

            /^MemAvailable:/ {
                memory_available = $2
                have_memory_available = 1
            }

            /^SwapTotal:/ {
                swap_total = $2
                have_swap_total = 1
            }

            /^SwapFree:/ {
                swap_free = $2
                have_swap_free = 1
            }

            END {
                if (have_memory_total &&
                    have_memory_available &&
                    memory_total > 0 &&
                    memory_available >= 0 &&
                    memory_available <= memory_total) {
                    memory_used = memory_total - memory_available
                    memory_percent = int(memory_used * 100 / memory_total + 0.5)

                    printf "%s / %s GiB (%d%%)\n",
                        tidy(memory_used / 1048576),
                        tidy(memory_total / 1048576),
                        memory_percent
                } else {
                    print "unavailable"
                }

                if (have_swap_total &&
                    have_swap_free &&
                    swap_total == 0) {
                    print "disabled"
                } else if (have_swap_total &&
                    have_swap_free &&
                    swap_total > 0 &&
                    swap_free >= 0 &&
                    swap_free <= swap_total) {
                    swap_used = swap_total - swap_free
                    swap_percent = int(swap_used * 100 / swap_total + 0.5)

                    printf "%s / %s GiB (%d%%)\n",
                        tidy(swap_used / 1048576),
                        tidy(swap_total / 1048576),
                        swap_percent
                } else {
                    print "unavailable"
                }
            }
        ' /proc/meminfo 2>/dev/null
    )

    memory_text=${memory_lines[0]:-unavailable}
    swap_text=${memory_lines[1]:-unavailable}
}

collect_disk_info() {
    disk_text="unavailable"

    if ! command -v df >/dev/null 2>&1 ||
        ! command -v awk >/dev/null 2>&1; then
        return 0
    fi

    disk_text=$(
        df -B1 --output=size,used,pcent / 2>/dev/null |
            awk '
                function tidy(number, text) {
                    text = sprintf("%.2f", number)
                    sub(/0+$/, "", text)
                    sub(/\.$/, "", text)
                    return text
                }

                NR == 2 && $1 > 0 && $2 >= 0 {
                    printf "%s / %s GiB (%s)\n",
                        tidy($2 / 1073741824),
                        tidy($1 / 1073741824),
                        $3
                }
            '
    )

    disk_text=${disk_text:-unavailable}
}

collect_network_family() {
    local family=$1
    local label_prefix=$2
    local address
    local address_output=""
    local device
    local empty_text="unavailable"
    local interface=""
    local label="${label_prefix}:"
    local route
    local route_output=""
    local -a addresses=()

    if address_output=$(
        ip -o "-${family}" address show scope global 2>/dev/null
    ); then
        empty_text="not configured"

        if route_output=$(
            ip "-${family}" route show default 2>/dev/null
        ); then
            while IFS= read -r route; do
                if [[ -n $route ]] &&
                    interface=$(extract_route_device "$route"); then
                    interface=${interface%%@*}
                    break
                fi
            done <<< "$route_output"
        fi

        if [[ -z $interface ]]; then
            while read -r _ device _ address _; do
                if [[ -n $device && -n $address ]]; then
                    interface=${device%%@*}
                    break
                fi
            done <<< "$address_output"
        fi

        if [[ -n $interface ]]; then
            label="${label_prefix} for ${interface}:"

            while read -r _ device _ address _; do
                device=${device%%@*}

                if [[ $device == "$interface" && -n $address ]]; then
                    addresses+=("${address%/*}")
                fi
            done <<< "$address_output"
        fi
    fi

    case $family in
        4)
            ipv4_empty_text=$empty_text
            ipv4_label=$label
            ipv4_addresses=("${addresses[@]}")
            ;;
        6)
            ipv6_empty_text=$empty_text
            ipv6_label=$label
            ipv6_addresses=("${addresses[@]}")
            ;;
    esac
}

collect_network_info() {
    ipv4_empty_text="unavailable"
    ipv6_empty_text="unavailable"
    ipv4_label="IPv4:"
    ipv6_label="IPv6:"
    ipv4_addresses=()
    ipv6_addresses=()

    if ! command -v ip >/dev/null 2>&1; then
        return 0
    fi

    collect_network_family 4 "IPv4"
    collect_network_family 6 "IPv6"
}

collect_activity_info() {
    local nullglob_was_enabled=0
    local session_line
    local who_output=""
    local -a process_directories=()

    process_count="unavailable"
    login_sessions="unavailable"

    if [[ -d /proc ]]; then
        if shopt -q nullglob; then
            nullglob_was_enabled=1
        fi

        shopt -s nullglob
        process_directories=(/proc/[0-9]*)

        if ((nullglob_was_enabled == 0)); then
            shopt -u nullglob
        fi

        if ((${#process_directories[@]} > 0)); then
            process_count=${#process_directories[@]}
        fi
    fi

    if command -v who >/dev/null 2>&1 &&
        who_output=$(who 2>/dev/null); then
        login_sessions=0

        while IFS= read -r session_line; do
            if [[ -n $session_line ]]; then
                ((login_sessions += 1))
            fi
        done <<< "$who_output"
    fi
}

print_motd() {
    printf 'Welcome to %s running %s\n\n' "$hostname" "$os_text"

    printf 'System information as of %s\n\n' "$timestamp"

    print_field "Kernel:" "${kernel}, ${architecture}"

    printf '\n'

    print_field "Uptime:" "$uptime_text"

    printf '\n'

    print_field "CPU:" "$cpu_text"
    print_field "Load average:" "$load_text"
    print_field "Memory:" "$memory_text"
    print_field "Swap:" "$swap_text"
    print_field "Disk (/):" "$disk_text"

    printf '\n'

    print_multiline_field \
        "$ipv4_label" "$ipv4_empty_text" "${ipv4_addresses[@]}"
    print_multiline_field \
        "$ipv6_label" "$ipv6_empty_text" "${ipv6_addresses[@]}"
    print_field "Processes:" "$process_count"
    print_field "Login sessions:" "$login_sessions"
}

main() {
    collect_system_info
    collect_uptime
    collect_cpu_info
    collect_load_info
    collect_memory_info
    collect_disk_info
    collect_network_info
    collect_activity_info
    print_motd
}

main "$@"
